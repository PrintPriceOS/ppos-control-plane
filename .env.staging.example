# .env.staging.example — PrintPrice OS Control Plane Staging Environment Template
# IMPORTANT: Never commit real passwords or secret tokens to git repositories.

# --- Core Server Runtime ---
NODE_ENV=staging
PORT=8081 # Internal container listening port (published on host loopback 127.0.0.1:18081)
PPOS_CONTROL_MODE=STAGING
PPOS_LOG_LEVEL=info

# --- MySQL 8.0 Staging Persistence ---
# Note: In Docker Compose, host is the internal service name 'staging-mysql'
MYSQL_HOST=staging-mysql
MYSQL_PORT=3306
MYSQL_DATABASE=ppos_control_staging
MYSQL_USER=ppos_staging_usr
# Password must be populated via Docker secret or protected file
# MYSQL_PASSWORD=<generate_via_csprng_32_chars>
DB_POOL_LIMIT=20

# Optional full URL format (takes precedence in mysqlClient if provided)
# DATABASE_URL=mysql://ppos_staging_usr:<password>@staging-mysql:3306/ppos_control_staging

# --- Authentication & JWT Contracts ---
# Minimum 64-char high-entropy symmetric secret
# JWT_SECRET=<generate_via_csprng_64_chars>
JWT_AUDIENCE=ppos:control:staging
JWT_ISSUER=https://staging-auth.printprice.pro
REQUIRE_JWT_ONLY=true
ENABLE_BREAK_GLASS_TOKEN=false

# --- Document & Storage Isolation ---
# Must be mounted to dedicated Docker volume, completely isolated from production
PPOS_UPLOADS_DIR=/opt/printprice-os/staging-storage

# --- Commercial & External Integration Containment (Fail-Closed) ---
CHECKLIST_ONLY_MODE=ACTIVE
MARKETPLACE_VISIBLE=false
LIVE_QUOTING_ALLOWED=false
JOB_ROUTING_ALLOWED=false
PRODUCTION_DISPATCH_ALLOWED=false
PAYMENT_EXECUTION_ENABLED=false
PAYOUT_EXECUTION_ENABLED=false
REFUND_EXECUTION_ENABLED=false
LIVE_PROVIDER_CONNECTIVITY=false

# Webhooks and Outgoing Network Isolation
WEBHOOK_DISPATCH_MOCK_ONLY=true
OUTGOING_WEBHOOK_SINK_URL=http://127.0.0.1:9999/sink
