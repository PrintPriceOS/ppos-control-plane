# ==============================================================================
# PrintPrice OS — Control Plane & Transactional Spine (.env.example)
# Canonical Environment Configuration Template (control.printprice.pro)
# ==============================================================================

# 1. Server & Runtime Environment
NODE_ENV=development
PORT=3200
PUBLIC_BASE_URL=https://control.printprice.pro
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:5173,https://budget.printprice.pro,https://control.printprice.pro

# 2. Primary MySQL Database (Marketplace Orders, Escrow Ledger, B2B Profiles)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=ppos_app
DB_PASSWORD=change_me_strong_mysql_password
DB_NAME=ppos_control_plane
DB_CONNECTION_LIMIT=10

# 3. Authentication, JWT & RBAC Governance
PPOS_JWT_SECRET=change_me_min_32_bytes_cryptographic_jwt_secret
PPOS_JWT_ISSUER=https://auth.printprice.pro
PPOS_JWT_AUDIENCE=ppos:control
PPOS_ADMIN_PASSWORD=change_me_super_admin_password
PPOS_SERVICE_TOKEN=change_me_internal_service_to_service_token
PPOS_CONTROL_TOKEN=change_me_control_plane_master_token
PPOS_MARKETPLACE_INTAKE_TOKEN=change_me_bff_to_control_plane_intake_token

# 4. BPE (Book Pricing Engine) & Preflight Engine Connectivity
BPE_BASE_URL=https://bpe.printprice.pro
PREFLIGHT_BASE_URL=https://preflight.printprice.pro
PREFLIGHT_SERVICE_TOKEN=change_me_preflight_service_token

# 5. Financial Settlement, Stripe Checkout & Commercial Escrow (EN 16931)
STRIPE_SECRET_KEY=sk_test_change_me_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_change_me_stripe_webhook_secret
PPOS_ESCROW_BENEFICIARY="PrintPrice OS Commercial Escrow (Merchant of Record)"
PPOS_ESCROW_IBAN="ES91 2100 0418 4502 0005 1332"
PPOS_ESCROW_BIC="CAIXESBBXXX"
PPOS_ESCROW_BANK_NAME="CaixaBank Corporate Escrow Division"
PPOS_SELLER_CORPORATE_NAME="PrintPrice OS Europe Industrial Print Hub S.L."
PPOS_SELLER_VAT_ID="ESB67890123"

# 6. Physical Asset Storage & Demo Seeding Controls
PPOS_MARKETPLACE_FILES_DIR=./storage/marketplace_orders
# Set to 'true' in demo/staging or 'false' in strict multi-tenant production
PPOS_SEED_DEMO_ORDERS=true

# 7. Transactional SMTP Email Engine (Postmark / SendGrid / Amazon SES / Local Postfix)
# Leave SMTP_HOST empty in local dev/testing to enable deterministic outbox simulation
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="PrintPrice OS Industrial Control Plane <no-reply@printprice.pro>"
BUDGET_PORTAL_BASE_URL=https://budget.printprice.pro


